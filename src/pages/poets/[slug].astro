---
import Layout from '../../layouts/Layout.astro';
import { poets } from '../../data/poets';
export function getStaticPaths() {return poets.map(poet => ({params: {slug:poet.slug}, props:{poet}}));}
const {poet} = Astro.props;
const base = import.meta.env.BASE_URL;
const next = poets[(poets.findIndex(p=>p.slug===poet.slug)+1)%poets.length];
---
<Layout title={`${poet.first} ${poet.last} — Серебряный век`} description={poet.description}><main id="main" class="wrap poet-page"><a class="back-link" href={`${base}#poets`}>← Все поэты</a><div class="poet-page-heading"><div><span class="eyebrow">{poet.era} / {poet.years}</span><h1>{poet.first}<br/><em>{poet.last}</em></h1>{poet.era === 'Золотой век' && <p class="era-note">Предшественник Серебряного века · поэзия XIX столетия</p>}<p class="poet-lead">{poet.description}</p></div><div class={`poet-card portrait ${poet.color}`} aria-hidden="true"><div class="poet-art"><span class="monogram">{poet.mark}</span><span class="art-star">✳</span><span class="art-years">{poet.years}</span></div></div></div><div class="biography"><section><span class="eyebrow">ПОЭТИЧЕСКИЙ МИР</span><h2>Жизнь в слове</h2><p>{poet.bio}</p></section><section><span class="eyebrow">КНИЖНАЯ ПОЛКА</span><h2>С чего начать</h2><ul>{poet.books.map(book=><li>{book}</li>)}</ul></section></div><section class="poetry-collection" aria-labelledby="poems-heading"><span class="eyebrow">ЧИТАЕМ СТИХИ / {poet.poems.length} ПРОИЗВЕДЕНИЯ</span><h2 id="poems-heading">Избранные стихотворения</h2><nav class="poem-toc" aria-label="Стихотворения поэта">{poet.poems.map(poem => <a href={`#${poem.id}`}>{poem.title} <span>{poem.year} ↓</span></a>)}</nav>{poet.poems.map(poem => <article id={poem.id} class="profile-poem"><span class="eyebrow">{poem.year}</span><h3>{poem.title}</h3><p class="verse">{poem.text}</p><a class="back-link" href="#poems-heading">К списку стихотворений ↑</a></article>)}</section><div class="profile-bottom"><a href="https://www.culture.ru/literature/poems" target="_blank" rel="noreferrer">Больше поэзии на Культура.РФ ↗</a><a href={`${base}poets/${next.slug}/`}>Следующий голос: {next.first} {next.last} →</a></div></main></Layout>
